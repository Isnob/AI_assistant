# Public service URLs
N8N_EDITOR_BASE_URL=https://example.duckdns.org/
WEBHOOK_URL=https://example.duckdns.org/

# n8n
N8N_ENCRYPTION_KEY=replace-with-32-byte-random-secret
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Postgres
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=n8n_data
DB_POSTGRESDB_HOST=db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_data
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=replace-me

# Outbound proxy used for model providers when required by the host network.
HTTP_PROXY=http://127.0.0.1:1081
HTTPS_PROXY=http://127.0.0.1:1081
GLOBAL_AGENT_HTTP_PROXY=http://127.0.0.1:1081
GLOBAL_AGENT_HTTPS_PROXY=http://127.0.0.1:1081
NO_PROXY=localhost,127.0.0.1,db,postgres,duckdns,nginx-proxy,api.telegram.org
GLOBAL_AGENT_NO_PROXY=localhost,127.0.0.1,db,postgres,duckdns,nginx-proxy,api.telegram.org

# DuckDNS
DUCKDNS_SUBDOMAINS=example-subdomain
DUCKDNS_TOKEN=replace-me

